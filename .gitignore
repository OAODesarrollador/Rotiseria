# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.*
!.env.example


# typescript
*.tsbuildinfo
next-env.d.ts

# vercel (local build/output)
.vercel

# local database
#local.db

# local databases and dumps
local.db
**/local.db
local_dump*.sql
*.db
*.sqlite
*.sqlite3

# local virtual environments
.venv/
venv/

# logs
*.log

# repository-only operational files are kept; ignore local docs and one-off notes
*.md
!README.md

# local/admin guides and generated reference files
ADMIN_ACCESS_GUIDE.md
DATABASE_UPDATE_MODULES.md
IMPLEMENTATION_COMPLETE.md
SECURITY.md
SETUP_GUIDE.md
EJEMPLO_PLANILLA.txt
page-content.html

# one-off migration, dump, test and inspection scripts at repo root
/*.sql
/*.py
/*migration*.js
/*turso*.mjs
/apply-local-sql-to-turso.mjs
/check-turso-counts.mjs
/check-turso.mjs
/export_localdb_to_sql.py
/local-to-turso.mjs
/migrate-data.mjs
/read-local-db.py
/test-migration.js
/test-turso.mjs

# nested local artifacts/copies
/la-parrilla-app/

